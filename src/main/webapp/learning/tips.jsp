<%@ page contentType="text/html;charset=UTF-8" %>
<%@ include file="../common/header.jsp" %>

<section class="content-section site-container reveal">
    <div class="section-head">
        <span class="eyebrow i18n" data-en="Learning Corner" data-ml="പഠന കോർണർ">Learning Corner</span>
        <h2 class="i18n" data-en="Cyber safety tips" data-ml="സൈബർ സുരക്ഷാ ടിപ്പുകൾ">Cyber safety tips</h2>
        <p class="i18n" data-en="Eight habits that stop most scams." data-ml="മിക്ക തട്ടിപ്പുകളും തടയുന്ന എട്ട് ശീലങ്ങൾ.">Eight habits that stop most scams.</p>
    </div>

    <div class="tip-grid">
        <div class="tip-card">
            <div class="tip-icon"><i class="fa-solid fa-lock" aria-hidden="true"></i></div>
            <h3 class="i18n" data-en="Unique passwords + 2FA" data-ml="വ്യത്യസ്ത പാസ്‌വേഡുകൾ + 2FA">Unique passwords + 2FA</h3>
            <p class="i18n" data-en="A different password per account, plus two-factor authentication on email and banking." data-ml="ഓരോ അക്കൗണ്ടിനും വ്യത്യസ്ത പാസ്‌വേഡ്, ഇമെയിലിനും ബാങ്കിംഗിനും ടു-ഫാക്ടർ ഓതന്റിക്കേഷൻ.">A different password per account, plus two-factor authentication on email and banking.</p>
        </div>
        <div class="tip-card">
            <div class="tip-icon"><i class="fa-solid fa-link-slash" aria-hidden="true"></i></div>
            <h3 class="i18n" data-en="Check before you click" data-ml="ക്ലിക്ക് ചെയ്യും മുൻപ് പരിശോധിക്കുക">Check before you click</h3>
            <p class="i18n" data-en="Hover to see the real link. Urgent, threatening messages are almost always fake." data-ml="യഥാർത്ഥ ലിങ്ക് കാണാൻ ഹോവർ ചെയ്യുക. അടിയന്തിര, ഭീഷണി സന്ദേശങ്ങൾ മിക്കവാറും വ്യാജമാണ്.">Hover to see the real link. Urgent, threatening messages are almost always fake.</p>
        </div>
        <div class="tip-card">
            <div class="tip-icon"><i class="fa-solid fa-indian-rupee-sign" aria-hidden="true"></i></div>
            <h3 class="i18n" data-en="OTP is never needed to receive money" data-ml="പണം സ്വീകരിക്കാൻ OTP ആവശ്യമില്ല">OTP is never needed to receive money</h3>
            <p class="i18n" data-en="Anyone asking for an OTP to 'release' a refund or payment is scamming you." data-ml="റീഫണ്ട് അല്ലെങ്കിൽ പേയ്‌മെന്റ് 'റിലീസ്' ചെയ്യാൻ OTP ചോദിക്കുന്നത് തട്ടിപ്പാണ്.">Anyone asking for an OTP to "release" a refund or payment is scamming you.</p>
        </div>
        <div class="tip-card">
            <div class="tip-icon"><i class="fa-solid fa-user-secret" aria-hidden="true"></i></div>
            <h3 class="i18n" data-en="Guard your personal details" data-ml="നിങ്ങളുടെ വിവരങ്ങൾ സൂക്ഷിക്കുക">Guard your personal details</h3>
            <p class="i18n" data-en="Birthdates, phone numbers, and travel plans on social media help scammers target you." data-ml="ജനനത്തീയതി, ഫോൺ നമ്പർ, യാത്രാ പദ്ധതികൾ എന്നിവ സോഷ്യൽ മീഡിയയിൽ പങ്കിടുന്നത് തട്ടിപ്പുകാരെ സഹായിക്കും.">Birthdates, phone numbers, and travel plans on social media help scammers target you.</p>
        </div>
        <div class="tip-card">
            <div class="tip-icon"><i class="fa-solid fa-download" aria-hidden="true"></i></div>
            <h3 class="i18n" data-en="Only install apps from official stores" data-ml="ഔദ്യോഗിക സ്റ്റോറുകളിൽ നിന്ന് മാത്രം ആപ്പുകൾ ഇൻസ്റ്റാൾ ചെയ്യുക">Only install apps from official stores</h3>
            <p class="i18n" data-en="Avoid APKs sent over chat, especially 'remote support' or 'screen-sharing' apps." data-ml="ചാറ്റിലൂടെ അയക്കുന്ന APK-കൾ, പ്രത്യേകിച്ച് 'റിമോട്ട് സപ്പോർട്ട്' ആപ്പുകൾ ഒഴിവാക്കുക.">Avoid APKs sent over chat, especially "remote support" or "screen-sharing" apps.</p>
        </div>
        <div class="tip-card">
            <div class="tip-icon"><i class="fa-solid fa-child-reaching" aria-hidden="true"></i></div>
            <h3 class="i18n" data-en="Talk to children about online safety" data-ml="കുട്ടികളോട് ഓൺലൈൻ സുരക്ഷയെക്കുറിച്ച് സംസാരിക്കുക">Talk to children about online safety</h3>
            <p class="i18n" data-en="Tell them to inform a trusted adult if a stranger asks for photos or secrecy." data-ml="അപരിചിതർ ഫോട്ടോയോ രഹസ്യമോ ചോദിച്ചാൽ വിശ്വസ്തരായ മുതിർന്നവരോട് പറയാൻ പറയുക.">Tell them to inform a trusted adult if a stranger asks for photos or secrecy.</p>
        </div>
        <div class="tip-card">
            <div class="tip-icon"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></div>
            <h3 class="i18n" data-en="Verify before you trust" data-ml="വിശ്വസിക്കും മുൻപ് ഉറപ്പാക്കുക">Verify before you trust</h3>
            <p>
                <span class="i18n" data-en="Run any link or contact through" data-ml="ഏതെങ്കിലും ലിങ്കോ കോൺടാക്റ്റോ" >Run any link or contact through</span>
                <a href="<%= request.getContextPath() %>/user/suspect-check.jsp" class="i18n" data-en="Check Suspect" data-ml="ചെക്ക് സസ്‌പെക്റ്റ്">Check Suspect</a>
                <span class="i18n" data-en="before you act on it." data-ml="വഴി പരിശോധിച്ച ശേഷം മാത്രം പ്രവർത്തിക്കുക.">before you act on it.</span>
            </p>
        </div>
        <div class="tip-card">
            <div class="tip-icon"><i class="fa-solid fa-flag" aria-hidden="true"></i></div>
            <h3 class="i18n" data-en="Report early, not just after loss" data-ml="നഷ്ടത്തിന് ശേഷം മാത്രമല്ല, നേരത്തെ റിപ്പോർട്ട് ചെയ്യുക">Report early, not just after loss</h3>
            <p class="i18n" data-en="Early reports help freeze funds faster and warn others sooner." data-ml="നേരത്തെയുള്ള റിപ്പോർട്ടുകൾ പണം മരവിപ്പിക്കാനും മറ്റുള്ളവർക്ക് മുന്നറിയിപ്പ് നൽകാനും സഹായിക്കും.">Early reports help freeze funds faster and warn others sooner.</p>
        </div>
    </div>
</section>

<%@ include file="../common/footer.jsp" %>
